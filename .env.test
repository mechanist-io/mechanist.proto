#SWAGGER:
SWAGGER_ENABLED=true
SWAGGER_PATH=/api
ENABLE_DEV_ONLY_ENDPOINTS=true

#CORE:
PORT=9000
ENV="test"
HOST=127.0.0.1

#REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=123456

#POSTGRESQL
TYPEORM_TYPE=postgres
TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=5432
TYPEORM_DATABASE=BoilerplateDatabase
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=123456
TYPEORM_SYNC=false
TYPEORM_SSL_ON=false
TYPEORM_SSL_CA_PATH=db.crt
TYPEORM_SSL_REJECT_UNAUTHORIZED=false


# AWS S3 Bucket
S3_BUCKET_NAME=test
S3_BUCKET_REGION=test
S3_BUCKET_ACCESS_KEY_ID=test
S3_BUCKET_SECRET_ACCESS_KEY=test

OFFICIAL_BOT_API_KEY="example"