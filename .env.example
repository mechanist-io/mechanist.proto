#SWAGGER:
SWAGGER_ENABLED=true
SWAGGER_PATH=/api
ENABLE_DEV_ONLY_ENDPOINTS=true

#CORE:
PORT=9000
ENV=production
HOST=127.0.0.1

# CORS (comma-separated frontend origins — required in production)
# CORS_ORIGINS=https://your-frontend.example.com,http://localhost:3000

# Mongoose (disabled — uncomment when MongoDB is ready)
# DATABASE_CONNECTION_STRING=mongodb://localhost:27017/mechanist
# DATABASE_SSL_ON=false
# DATABASE_SSL_CA_PATH=
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Telegram
TELEGRAM_CRITICAL_ERROR_WEBHOOK=https://api.telegram.org/bot<your-bot-token>/sendMessage
TELEGRAM_CHANNEL_ID=-1000000000000
